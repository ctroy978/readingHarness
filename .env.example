# Copy to .env and fill in the values. Never commit .env.
TICKET_SECRET=replace-with-at-least-32-random-bytes
GITHUB_REPO=owner/reading-lessons
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REF=main
GITHUB_LESSON_PATH=lessons
# Optional on Render; defaults to RENDER_EXTERNAL_URL there.
PUBLIC_BASE_URL=http://127.0.0.1:8000
DISPLAY_TIMEZONE=UTC
# Optional curriculum-gap email alerts through Resend.
RESEND_API_KEY=re_replace_me
RESEND_FROM=Krewone Tutorials <tutorials@krewnine.umaread.org>
RESEND_REPLY_TO=ctroy978@gmail.com
ALERT_EMAIL_TO=ctroy978@gmail.com
